# ==========================================
# ETHSLTD-NEW Production Environment Variables Template
# ==========================================

# Public URLs
NEXT_PUBLIC_API_URL="https://api-ethsltd-new.ethsltd.workers.dev"
NEXT_PUBLIC_APP_URL="https://ethsltd.com"

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_D1_DATABASE_NAME="ethsltd-new"
CLOUDFLARE_D1_DATABASE_ID="your_d1_database_id"

# Authentication & Security
JWT_SECRET="your_secure_random_jwt_secret_here"

# Email Configuration (Brevo / SMTP)
BREVO_API_KEY="your_brevo_api_key_optional"
EMAIL_FROM="support@ethsltd.com"
EMAIL_FROM_NAME="ETHSLTD Security"
EMAIL_REPLY_TO="support@ethsltd.com"

# SMTP Relay Configuration (Optional if Brevo is used)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your_smtp_user"
SMTP_PASS="your_smtp_password"
SMTP_SECURE="false"

# Cregis Crypto Gateway Proxy (Optional / Backend)
CREGIS_PROXY_URL="https://techilyfly.com/ethsltd/cregis-proxy.php"
CREGIS_PROXY_SECRET="your_proxy_secret"
CREGIS_WAAS_API_KEY=""
CREGIS_WAAS_PROJECT_ID=""
CREGIS_BASE_URL="https://api.cregis.io"
