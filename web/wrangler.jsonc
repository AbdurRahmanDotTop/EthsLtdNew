{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ethsltd-new",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "ethsltd.com", "custom_domain": true },
    { "pattern": "www.ethsltd.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ethsltd-new",
      "database_id": "9fa25eaa-6b12-4da0-ad92-8f2a9ec41496"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://api-ethsltd-new.ethsltd.workers.dev",
    "NEXT_PUBLIC_APP_URL": "https://ethsltd.com",
    "JWT_SECRET": "ethsltd_super_secret_jwt_key_2026_production",
    "EMAIL_FROM": "support@ethsltd.com",
    "EMAIL_FROM_NAME": "ETHSLTD",
    "EMAIL_FROM_NAME_SECURITY": "ETHSLTD Security",
    "EMAIL_FROM_NAME_ORDERS": "ETHSLTD Orders",
    "EMAIL_FROM_NAME_P2P": "ETHSLTD P2P",
    "EMAIL_FROM_NAME_WALLET": "ETHSLTD Wallet",
    "EMAIL_FROM_NAME_PAYMENTS": "ETHSLTD Payments",
    "EMAIL_FROM_NAME_VERIFICATION": "ETHSLTD Verification",
    "EMAIL_FROM_NAME_SUPPORT": "ETHSLTD Support",
    "EMAIL_FROM_NAME_COMPLIANCE": "ETHSLTD Compliance",
    "EMAIL_FROM_NAME_MARKET_ALERTS": "ETHSLTD Market Alerts",
    "EMAIL_FROM_NAME_ACCOUNT": "ETHSLTD Account",
    "EMAIL_FROM_NAME_UPDATES": "ETHSLTD Updates",
    "EMAIL_FROM_NAME_REWARDS": "ETHSLTD Rewards",
    "EMAIL_FROM_NAME_REPORTS": "ETHSLTD Reports",
    "EMAIL_FROM_NAME_ADMIN_ALERTS": "ETHSLTD Admin Alerts",
    "EMAIL_FROM_NAME_API_SECURITY": "ETHSLTD API Security"
  }
}
